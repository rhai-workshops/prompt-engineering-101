apiVersion: v1
kind: Secret
metadata:
  name: openwebui-secrets
type: Opaque
stringData:
  # MAAS API Configuration
  # Update with your actual API key
  OPENAI_API_KEY: "sk-your-maas-api-key-here"
  
  # Security
  # Generate with: openssl rand -base64 32
  WEBUI_SECRET_KEY: "change-me-to-a-secure-random-key-min-32-chars"
